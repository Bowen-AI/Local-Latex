{
  "name": "latex-one-click",
  "displayName": "LaTeX One-Click",
  "description": "Compile LaTeX locally in VS Code with Tectonic: no full TeX distribution required, on-demand packages, integrated PDF preview with SyncTeX navigation from PDF to source. Open source.",
  "version": "0.1.2",
  "publisher": "BowenAI",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bowen-AI/Local-Latex"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "latex",
    "tectonic",
    "pdf",
    "synctex",
    "compile",
    "typesetting",
    "local",
    "privacy",
    "opensource",
    "cursor",
    "research",
    "paper",
    "thesis"
  ],
  "type": "commonjs",
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:latex",
    "workspaceContains:**/*.[tT][eE][xX]",
    "onView:latexOneClickProject",
    "onView:latexOneClickCompile",
    "onCommand:latexOneClick.compile",
    "onCommand:latexOneClick.openPdf",
    "onCommand:latexOneClick.clean",
    "onCommand:latexOneClick.selectRoot",
    "onCommand:latexOneClick.doctor",
    "onCommand:latexOneClick.revealTexLocation",
    "onCommand:latexOneClick.sidebarToggleBool",
    "onCommand:latexOneClick.sidebarEditOutputDirectory",
    "onCommand:latexOneClick.jumpToFirstError",
    "onCommand:latexOneClick.showCompileLog",
    "onCommand:latexOneClick.copyCompileLog"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "LaTeX: Doctor can report trust, runtime, and workspace status. Compile, clean, preview, and root-selection commands require a trusted workspace."
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:extension": "npm run compile && node ./scripts/extension-host-smoke.js",
    "smoke": "npm run compile && node ./scripts/smoke-test.js",
    "test:local": "bash ./scripts/local-testbed.sh",
    "package": "npm run compile && npm run package:check && vsce package --no-dependencies",
    "package:check": "node ./scripts/check-package-contents.js",
    "package:vsix": "npm run compile && npm run typecheck && npm run lint && npm test && npm run smoke && npm run package",
    "publish:vscode": "bash ./scripts/publish-extension.sh vscode",
    "publish:openvsx": "bash ./scripts/publish-extension.sh openvsx",
    "publish:all": "bash ./scripts/publish-extension.sh all",
    "release:marketplaces": "bash ./scripts/publish-extension.sh",
    "vscode:prepublish": "npm run compile"
  },
  "contributes": {
    "commands": [
      {
        "command": "latexOneClick.compile",
        "title": "LaTeX: Compile Document"
      },
      {
        "command": "latexOneClick.openPdf",
        "title": "LaTeX: Open PDF Preview"
      },
      {
        "command": "latexOneClick.clean",
        "title": "LaTeX: Clean Build Artifacts"
      },
      {
        "command": "latexOneClick.selectRoot",
        "title": "LaTeX: Select Root File"
      },
      {
        "command": "latexOneClick.doctor",
        "title": "LaTeX: Doctor (Show Extension Health)"
      },
      {
        "command": "latexOneClick.revealTexLocation",
        "title": "LaTeX: Reveal Source Location"
      },
      {
        "command": "latexOneClick.sidebarToggleBool",
        "title": "LaTeX: Toggle Sidebar Setting"
      },
      {
        "command": "latexOneClick.sidebarEditOutputDirectory",
        "title": "LaTeX: Edit Output Directory (Sidebar)"
      },
      {
        "command": "latexOneClick.jumpToFirstError",
        "title": "LaTeX: Jump to First Error"
      },
      {
        "command": "latexOneClick.showCompileLog",
        "title": "LaTeX: Show Compile Log"
      },
      {
        "command": "latexOneClick.copyCompileLog",
        "title": "LaTeX: Copy Compile Log"
      }
    ],
    "configuration": {
      "title": "LaTeX One-Click",
      "properties": {
        "latexOneClick.autoCompileOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically compile on save"
        },
        "latexOneClick.compileDebounceMs": {
          "type": "number",
          "default": 1000,
          "description": "Debounce delay for auto-compile in ms"
        },
        "latexOneClick.mainFile": {
          "type": "string",
          "default": "",
          "description": "Main LaTeX file to compile"
        },
        "latexOneClick.outputDirectory": {
          "type": "string",
          "default": "out",
          "description": "Output directory for compiled files"
        },
        "latexOneClick.offlineOnly": {
          "type": "boolean",
          "default": false,
          "description": "Use only cached packages (no network)"
        },
        "latexOneClick.compileTimeoutSec": {
          "type": "number",
          "default": 60,
          "description": "Compile timeout in seconds"
        },
        "latexOneClick.preview.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Auto-open PDF after compile"
        },
        "latexOneClick.preview.preserveFocus": {
          "type": "boolean",
          "default": true,
          "description": "Preserve editor focus when opening PDF"
        },
        "latexOneClick.syncTeX": {
          "type": "boolean",
          "default": true,
          "description": "Emit SyncTeX data during compile for source/PDF synchronization"
        },
        "latexOneClick.tectonicPrint": {
          "type": "boolean",
          "default": false,
          "description": "Pass --print to Tectonic so BibTeX and full engine output appear in the LaTeX One-Click output channel"
        },
        "latexOneClick.tectonicKeepLogs": {
          "type": "boolean",
          "default": false,
          "description": "Pass --keep-logs to Tectonic to retain intermediate log files under the output directory"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latexOneClick",
          "title": "LaTeX One-Click",
          "icon": "resources/latex-activity.svg"
        }
      ]
    },
    "views": {
      "latexOneClick": [
        {
          "id": "latexOneClickProject",
          "name": "Settings"
        },
        {
          "id": "latexOneClickCompile",
          "name": "Errors & Warnings"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.0.0",
    "pdfjs-dist": "^5.7.284",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
